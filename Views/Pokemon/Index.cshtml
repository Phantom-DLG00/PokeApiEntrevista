@model PokeApiEntrevista.ViewModels.PokemonListViewModel

@{
    // Define el titulo que aparecera en la pestana del navegador
    ViewData["Title"] = "Pokemon";
}

@if (TempData["EmailSuccess"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (TempData["EmailError"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<h1>Listado de Pokémon</h1>

<p>Pokémon obtenidos desde PokeAPI</p>

<form method="get" asp-controller="Pokemon" asp-action="Index" class="search-form">

    <input type="hidden" name="page" value="1" />

    <input type="hidden" name="pageSize" value="@Model.PageSize" />

    <label for="name">
        Buscar por nombre
    </label>

    <input id="name" name="name" value="@Model.NameFilter" placeholder="Ejemplo: pika" />

    <label for="species">
        Especie
    </label>

    <select id="species" name="species">

        <option value="">
            Todas las especies
        </option>

        @foreach (var species in Model.Species)
        {
            <option value="@species" selected="@(Model.SpeciesFilter == species ? "selected" : null)">
                @species
            </option>
        }
    </select>

    <button type="submit">
        Buscar
    </button>

    <a asp-controller="Pokemon" asp-action="Index" asp-route-page="1" asp-route-pageSize="@Model.PageSize">
        Limpiar
    </a>
</form>

<form method="get" asp-controller="Pokemon" asp-action="Index">

    <input type="hidden" name="name" value="@Model.NameFilter" />

    <input type="hidden" name="species" value="@Model.SpeciesFilter" />

    <input type="hidden" name="page" value="@Model.CurrentPage" />

    <input type="hidden" name="pageSize" value="@Model.PageSize" />

    <input type="hidden" name="export" value="true" />

    <button type="submit">
        Exportar pagina actual
    </button>
</form>



@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else if (Model.Pokemon.Count == 0)
{
    <div class="alert alert-warning">
        No se encontraron Pokémon con ese nombre
    </div>
}
else
{
    <p>
        Total disponibles:
        <strong>@Model.TotalCount</strong>
    </p>

    <form method="get" asp-controller="Pokemon" asp-action="Index" class="page-size-form">

        <input type="hidden" name="page" value="1" />

        <input type="hidden" name="name" value="@Model.NameFilter" />
        <input type="hidden" name="species" value="@Model.SpeciesFilter" />

        <label for="pageSize">
            Pokémon por página
        </label>

        <select id="pageSize" name="pageSize" onchange="this.form.submit()">

            <option value="12" selected="@(Model.PageSize == 12 ? "selected" : null)">
                12
            </option>

            <option value="24" selected="@(Model.PageSize == 24 ? "selected" : null)">
                24
            </option>

            <option value="48" selected="@(Model.PageSize == 48 ? "selected" : null)">
                48
            </option>

            <option value="96" selected="@(Model.PageSize == 96 ? "selected" : null)">
                96
            </option>
        </select>
    </form>

    <div class="pokemon-grid">
        @foreach (var pokemon in Model.Pokemon)
        {
            <article class="pokemon-card">
                <img src="@pokemon.ImageUrl" alt="Imagen de @pokemon.Name" loading="lazy" />

                <h2>@pokemon.Name</h2>
                <form method="post" asp-controller="Pokemon" asp-action="SendEmail">

                    @Html.AntiForgeryToken()

                    <input type="email" name="recipientEmail" placeholder="correo@ejemplo.com" required />

                    <input type="hidden" name="pokemonName" value="@pokemon.Name" />

                    <input type="hidden" name="imageUrl" value="@pokemon.ImageUrl" />

                    <input type="hidden" name="apiUrl" value="@pokemon.ApiUrl" />

                    <input type="hidden" name="name" value="@Model.NameFilter" />

                    <input type="hidden" name="species" value="@Model.SpeciesFilter" />

                    <input type="hidden" name="page" value="@Model.CurrentPage" />

                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                    <button type="submit">
                        Enviar por correo
                    </button>
                </form>
            </article>
        }
    </div>

    

    <div class="pagination-controls">
        @if (Model.HasPreviousPage)
        {
            <a asp-controller="Pokemon" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
               asp-route-species="@Model.SpeciesFilter" asp-route-pageSize="@Model.PageSize"
               asp-route-name="@Model.NameFilter">
                Anterior
            </a>
        }
        else
        {
            <span class="disabled">
                Anterior
            </span>
        }

        <span>
            Pagina @Model.CurrentPage de @Model.TotalPages
        </span>

        @if (Model.HasNextPage)
        {
            <a asp-controller="Pokemon" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
               asp-route-species="@Model.SpeciesFilter" asp-route-pageSize="@Model.PageSize"
               asp-route-name="@Model.NameFilter">
                Siguiente
            </a>
        }
        else
        {
            <span class="disabled">
                Siguiente
            </span>
        }
    </div>
}